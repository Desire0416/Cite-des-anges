# Adresse publique du site (domaine à confirmer avant raccordement)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mode démonstration : aucune demande n'est transmise à l'école (true par défaut)
NEXT_PUBLIC_DEMO_MODE=true

# Indexation par les moteurs de recherche (false pour la démonstration et la préproduction)
NEXT_PUBLIC_SITE_INDEXABLE=false

# Campagne d'admissions affichée (false pour la fermer sans modifier les pages)
NEXT_PUBLIC_CAMPAIGN_OPEN=true
NEXT_PUBLIC_CAMPAIGN_YEAR=2026–2027

# Numéro WhatsApp confirmé par la direction (format international sans « + »), laisser vide sinon
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Lien d'itinéraire vérifié sur place, laisser vide sinon
NEXT_PUBLIC_DIRECTIONS_URL=

# Hébergeur affiché dans les mentions légales
NEXT_PUBLIC_HOST_INFO=

# Vie scolaire : à activer uniquement avec des contenus réels approuvés
NEXT_PUBLIC_FEATURE_VIE_SCOLAIRE=false

# Mesure d'audience agrégée (désactivée en démonstration)
NEXT_PUBLIC_ANALYTICS=false

# Aperçu de gestion (côté serveur uniquement — ne jamais committer de vraies valeurs)
ADMIN_DEMO_PASSWORD=
# Au moins 32 caractères aléatoires
SESSION_SECRET=
